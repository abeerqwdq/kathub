function WhitelistModule:IsWhitelisted(username, scriptName)
    local scriptUsers = self[scriptName]
    
    if not scriptUsers then
        return false  -- Script doesn't exist
    end
    
    for _, whitelistedUser in ipairs(scriptUsers) do
        if whitelistedUser ~= "" and username == whitelistedUser then
            return true
        end
    end
    
    return false
end

return WhitelistModule
